# Copy to .env.local for local development; set the same names in Vercel → Settings → Environment Variables.

# Supabase → Project Settings → API (or "API Keys").
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The publishable (anon) key. Safe in the browser: it can read nothing (see the security migration).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The secret (service_role) key. SERVER ONLY. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Comma-separated emails that become admins the first time they sign in at /admin/login.
BOOTSTRAP_ADMIN_EMAILS=
